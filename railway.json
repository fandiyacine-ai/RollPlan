{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "PLAYWRIGHT_BROWSERS_PATH=/app/.playwright npx playwright install --with-deps chromium && npm run build"
  },
  "deploy": {
    "startCommand": "PATH=/nix/var/nix/profiles/default/bin:/root/.nix-profile/bin:$PATH node --max-old-space-size=8192 node_modules/.bin/next start -p $PORT",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/player-card
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/player-card

# Supabase / Postgres
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rollplan-videos
R2_PUBLIC_URL=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Google AI (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI (TTS for voice coaching)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Technique KB agent spend ceiling (USD, platform-wide month-to-date).
# The weekly KB agent skips its run once ai_call_logs shows this much spent
# this month. Defaults to 50. Set to 0 to disable the agent entirely.
KB_AGENT_MONTHLY_BUDGET_USD=50

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Cost guardrails
DAILY_SPEND_CAP_USD=50
ALERT_EMAIL=
